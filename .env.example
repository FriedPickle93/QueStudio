# Canonical URL for metadata, robots.txt, and sitemap.xml.
# Optional — falls back to the Vercel production URL automatically.
NEXT_PUBLIC_SITE_URL=

# Email delivery for the quote form (https://resend.com — free tier is plenty).
# Without this the form still works: it shows the visitor a copyable summary
# and the direct email address, so a lead is never silently lost.
RESEND_API_KEY=

# Where inquiries are delivered. Defaults to the address in src/lib/offer.ts.
INQUIRY_TO_EMAIL=

# Verified sender. Resend's shared onboarding@resend.dev only delivers to your
# own account address, so set this once a domain is verified.
INQUIRY_FROM_EMAIL="QueStudio <quotes@yourdomain.com>"
